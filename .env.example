# All data are synthetic. No API key is needed for the offline demo.
PRANAGUARD_DB=data/pranaguard.sqlite
PRANAGUARD_OFFLINE=true
# Optional: a shared demo admin token. Without it, mutation APIs are local-demo only.
PRANAGUARD_ADMIN_TOKEN=
# Browser traffic uses relative /api URLs; Vite proxies to this server-side target.
API_PROXY_TARGET=http://127.0.0.1:8000
